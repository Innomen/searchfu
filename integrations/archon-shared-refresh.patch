+def _shared_owner_valid(pid):
+    """Only the installed refresh child may borrow; never signal arbitrary PIDs.
+
+    Inspect the interpreter/script prefix only, never query arguments or content.
+    """
+    try:
+        with open(Path('/proc', str(pid), 'cmdline'), 'rb') as f:
+            prefix = []
+            for _ in range(2):
+                value = bytearray()
+                while len(value) < 4096:
+                    b = f.read(1)
+                    if not b: return False
+                    if b == b'\0': break
+                    value.extend(b)
+                prefix.append(os.fsdecode(bytes(value)))
+        return (Path(prefix[0]).name.startswith('python') and
+                Path(prefix[1]) == Path.home()/'.local/share/searchfu-app/refresh.py')
+    except (OSError, ValueError):
+        return False
 
 
