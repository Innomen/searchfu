+    def shared_lease_active(self):
+        lease = self._shared_lease
+        if not lease:
+            return False
+        if _process_starttime(lease['pid']) != lease['start']:
+            self._shared_lease = None
+            return False
+        # Even released/expired ownership blocks swaps until CUDA process exit.
+        return True
+
+    def acquire_shared_lease(self, pid):
+        """Small cooperative borrower; never unload or resize the resident brain."""
+        with self._lock:
+            try:
+                pid = int(pid)
+                start = _process_starttime(pid)
+                if (pid <= 1 or not start or Path('/proc', str(pid)).stat().st_uid != os.getuid()
+                        or not _shared_owner_valid(pid)):
+                    return {'ok': False, 'code': 'invalid_owner'}
+            except (OSError, ValueError, TypeError):
+                return {'ok': False, 'code': 'invalid_owner'}
+            if (self.inhibit_active() or self.vacate_guard_active() or
+                    self.external_lease_active() or self.shared_lease_active() or
+                    self.queue.running() or self.queue.pending() or self._exclusive_admitting):
+                return {'ok': False, 'code': 'scheduler_guard'}
+            occ = self.occupying_heavy()
+            if occ:
+                spec = self.cfg.tenants[occ]
+                if occ not in self.cfg.home_names or self.lc.status(spec) != 'ready' or self.lc.busy(spec):
+                    return {'ok': False, 'code': 'tenant_busy'}
+            free = free_vram_mib()
+            if free is None or free < 640:
+                return {'ok': False, 'code': 'low_vram'}
+            token = secrets.token_urlsafe(24)
+            self._shared_lease = {'token': token, 'pid': pid, 'start': start,
+                                  'deadline': time.monotonic() + 60, 'released': False}
+            return {'ok': True, 'token': token, 'allocator_mib': 256, 'batch_size': 8}
+
+    def check_shared_lease(self, token):
+        with self._lock:
+            lease = self._shared_lease
+            if (not self.shared_lease_active() or not lease or lease['released'] or
+                    not secrets.compare_digest(str(token), lease['token'])):
+                return {'ok': False}
+            free = free_vram_mib()
+            occ = self.occupying_heavy()
+            blocked = (time.monotonic() >= lease['deadline'] or self.inhibit_active() or
+                       self.vacate_guard_active() or self.queue.pending() or self.queue.running() or
+                       free is None or free < 192 or
+                       (occ and self.lc.busy(self.cfg.tenants[occ])))
+            return {'ok': not bool(blocked)}
+
+    def release_shared_lease(self, token):
+        with self._lock:
+            lease = self._shared_lease
+            if not lease or not secrets.compare_digest(str(token), lease['token']):
+                return {'ok': False}
+            lease['released'] = True
+            return {'ok': True}
+
+    def _quiesce_shared(self):
+        if not self.shared_lease_active():
+            return True
+        lease = self._shared_lease
+        try:
+            os.kill(lease['pid'], signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+        except OSError:
+            return False
+        deadline = time.monotonic() + 5
+        while self.shared_lease_active() and time.monotonic() < deadline:
+            time.sleep(.05)
+        return not self.shared_lease_active()
 
